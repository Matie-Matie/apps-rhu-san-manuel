APP_NAME="APPS - RHU Pharmacy Clinic"
APP_ENV=production
APP_KEY=base64:Y6NrHI56R4Opu2gvA9uSR/ReMWGo5D3fgECRVX3Q9f8=
APP_DEBUG=false
APP_URL=https://apps-rhu.site.je
APP_TIMEZONE=Asia/Manila

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# Use the exact hostname and credentials shown in the InfinityFree control panel.
# Do not use localhost for DB_HOST.
DB_CONNECTION=mysql
DB_HOST=sql311.infinityfree.com
DB_PORT=3306
DB_DATABASE=if0_42642517_apps_rhu
DB_USERNAME=if0_42642517
DB_PASSWORD=YOUR_INFINITYFREE_DATABASE_PASSWORD

# InfinityFree has no queue worker. File sessions/cache require no database
# tables and run reliably on shared hosting.
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=file

# Email verification is not required by the school-demo routes. Keep the log
# mailer unless an external SMTP account is configured for password resets.
MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
